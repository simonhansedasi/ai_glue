# Copy to .env and fill in your keys.

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Path to the SQLite audit database (default: audit.db in project root)
AIGLUE_DB=audit.db

# Set to false to store only the prompt hash instead of the full text.
# Useful when logs themselves might contain sensitive data.
AIGLUE_LOG_RAW=true
