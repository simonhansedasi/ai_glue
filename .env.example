# Copy to .env and fill in your keys.

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Path to the SQLite audit database (default: audit.db in project root)
AIGLUE_DB=audit.db

# Set to false to store only the prompt hash instead of the full text.
# Useful when logs themselves might contain sensitive data.
AIGLUE_LOG_RAW=true

# Set to true to replace detected PII (email, SSN, phone, credit card) with
# [REDACTED] before writing to the database. Governance flags are still recorded.
AIGLUE_REDACT_PII=false

# Optional shared secret. When set, every route except /proxy/* requires HTTP Basic auth with this value as the
# password (any username). Set the SAME value on every instance, including the aggregator and its children, or the
# aggregator cannot read them. Unset = open (legacy behaviour).
# AIGLUE_TOKEN=
